{
  "name": "meeting-recorder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "tauri:cuda": "tauri dev --features cuda",
    "tauri:build": "tauri build --config src-tauri/tauri.bundle.windows.conf.json",
    "tauri:build:cuda": "tauri build --features cuda --config src-tauri/tauri.cuda.conf.json",
    "test": "playwright test",
    "test:ui": "playwright test",
    "test:extension": "node --test browser-extension/test/*.test.mjs",
    "test:extension:browser": "playwright test --config=playwright.extension.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.9.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "license": "GPL-3.0-or-later"
}
